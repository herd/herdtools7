 (deps
  (env_var KVM_UNIT_TESTS)
  (env_var QEMU)
  %{bin:litmus7}
  (glob_files %{workspace_root}/herd/tests/instructions/AArch64.kvm/*.litmus)
  (source_tree %{workspace_root}/litmus/libdir)))
