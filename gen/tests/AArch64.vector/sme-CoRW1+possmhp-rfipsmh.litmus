(* diyone7 -arch AArch64 -variant sme -metadata false -oneloc SmH PosRW Rfi *)
AArch64 CoRW1+possmhp-rfipsmh
Variant=sme
{
 int x[4]={0,0,0,0};
 0:X0=x;
}
 P0                              ;
 SMSTART                         ;
 PTRUE P0.S,VL4                  ;
 MOV W12,WZR                     ;
 LD1W {ZA0H.S[W12,#0]},P0/Z,[X0] ;
 MOVA Z0.S,P0/M,ZA0H.S[W12,#0]   ;
 UADDV D1,P0,Z0.S                ;
 FMOV W1,S1                      ;
 SMSTOP                          ;
 MOV W2,#1                       ;
 STR W2,[X0]                     ;

exists (0:X1=1)
