(* diyone7 -arch AArch64 -metadata false Fre PodWW Rfe PodRR -type int8_t *)
AArch64 MP
{
 int8_t x=0;
 int8_t y=0;
 0:X1=x; 0:X3=y;
 int8_t 1:X0=0; 1:X1=x; int8_t 1:X2=0; 1:X3=y;
}
 P0           | P1           ;
 MOV W0,#1    | LDRB W0,[X3] ;
 STRB W0,[X1] | LDRB W2,[X1] ;
 MOV W2,#1    |              ;
 STRB W2,[X3] |              ;

exists (1:X0=1 /\ 1:X2=0)
