(* diyone7 -arch AArch64 -metadata false PodWW L Rfe DpAddrdR A Fre -type int8_t  *)
AArch64 MP+popl+addrpa
{
 int8_t x=0;
 int8_t y=0;
 0:X1=x; 0:X3=y;
 int8_t 1:X0=0; 1:X1=x; 1:X3=y; int8_t 1:X4=0;
}
 P0            | P1                ;
 MOV W0,#1     | LDRB W0,[X3]      ;
 STRB W0,[X1]  | EOR W2,W0,W0      ;
 MOV W2,#1     | ADD X5,X1,W2,SXTW ;
 STLRB W2,[X3] | LDARB W4,[X5]     ;

exists (1:X0=1 /\ 1:X4=0)
