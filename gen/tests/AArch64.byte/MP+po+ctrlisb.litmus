(* diyone7 -arch AArch64 -metadata false PodWW Rfe DpCtrlIsbdR Fre -type int8_t *)
AArch64 MP+po+ctrlisb
{
 int8_t x=0;
 int8_t y=0;
 0:X1=x; 0:X3=y;
 int8_t 1:X0=0; 1:X1=x; int8_t 1:X2=0; 1:X3=y;
}
 P0           | P1           ;
 MOV W0,#1    | LDRB W0,[X3] ;
 STRB W0,[X1] | CBNZ W0,LC00 ;
 MOV W2,#1    | LC00:        ;
 STRB W2,[X3] | ISB          ;
              | LDRB W2,[X1] ;

exists (1:X0=1 /\ 1:X2=0)
