(* diyone7 -arch AArch64 -metadata false -oneloc PosRW XA Rfi -type int8_t *)
AArch64 CoRW1+pospxa-rfixap
{
 int8_t x=0;
 0:X0=x; int8_t 0:X1=0; int8_t 0:X3=0;
}
 P0               ;
 LDRB W1,[X0]     ;
