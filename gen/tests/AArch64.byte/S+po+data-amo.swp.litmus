(* diyone7 -metadata false -arch AArch64 PodWW Rfe DpDatadR Amo.Swp Coe -type int8_t *)
AArch64 S+po+data-amo.swp
{
 int8_t x=0;
 int8_t y=0;
 0:X1=x; 0:X3=y;
 int8_t 1:X0=0; 1:X1=x; int8_t 1:X2=0; 1:X3=y;
}
 P0           | P1              ;
 MOV W0,#2    | LDRB W0,[X3]    ;
 STRB W0,[X1] | MOV W4,#1       ;
 MOV W2,#1    | EOR W5,W0,W0    ;
 STRB W2,[X3] | ADD W4,W4,W5    ;
              | SWPB W4,W2,[X1] ;

exists ([x]=2 /\ 1:X0=1 /\ 1:X2=0)
