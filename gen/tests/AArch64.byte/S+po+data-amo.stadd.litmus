AArch64 S+po+data-amo.stadd
{
 int8_t x=0;
 int8_t y=0;
 0:X1=x; 0:X3=y;
 int8_t 1:X0=0; 1:X1=x; 1:X3=y;
}
 P0           | P1             ;
 MOV W0,#2    | LDRB W0,[X3]   ;
 STRB W0,[X1] | MOV W2,#1      ;
