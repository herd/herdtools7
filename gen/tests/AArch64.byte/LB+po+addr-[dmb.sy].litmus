(* diyone7 -arch AArch64 -metadata false DpAddrdW DMB.SY Rfe PodRW Rfe -type int8_t *)
AArch64 LB+po+addr-[dmb.sy]
{
 int8_t x=0;
 int8_t y=0;
 0:X0=x; int8_t 0:X1=0; 0:X3=y;
 1:X0=x; int8_t 1:X1=0; 1:X3=y;
}
 P0           | P1                ;
 LDRB W1,[X0] | LDRB W1,[X3]      ;
 MOV W2,#1    | EOR W2,W1,W1      ;
 STRB W2,[X3] | ADD X0,X0,W2,SXTW ;
              | DMB SY            ;
              | MOV W4,#1         ;
              | STRB W4,[X0]      ;

exists (0:X1=1 /\ 1:X1=1)
