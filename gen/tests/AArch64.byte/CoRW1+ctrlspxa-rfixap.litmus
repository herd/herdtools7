(* diyone7 -arch AArch64 -metadata false -oneloc DpCtrlsW XA Rfi -type int8_t *)
AArch64 CoRW1+ctrlspxa-rfixap
{
 int8_t x=0;
 0:X0=x; int8_t 0:X1=0; int8_t 0:X3=0;
}
 P0               ;
 LDRB W1,[X0]     ;
 CBNZ W1,LC00     ;
 LC00:            ;
 MOV W2,#1        ;
 Loop01:          ;
 LDAXRB W3,[X0]   ;
 STXRB W4,W2,[X0] ;
 CBNZ W4,Loop01   ;

exists (0:X1=1 /\ 0:X3=0)
