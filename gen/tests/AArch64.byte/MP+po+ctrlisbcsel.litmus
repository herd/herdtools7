(* diyone7 -arch AArch64 -metadata false PodWW Rfe DpCtrlIsbCseldR Fre -type int8_t *)
AArch64 MP+po+ctrlisbcsel
{
 int8_t x=0;
 int8_t y=0;
 0:X1=x; 0:X3=y;
 int8_t 1:X0=0; 1:X1=x; 1:X3=y; int8_t 1:X4=0;
}
 P0           | P1                 ;
 MOV W0,#1    | LDRB W0,[X3]       ;
 STRB W0,[X1] | CMP W0,W0          ;
 MOV W2,#1    | CSEL W2,WZR,WZR,EQ ;
 STRB W2,[X3] | CBNZ W2,LC00       ;
              | LC00:              ;
              | ISB                ;
              | LDRB W4,[X1]       ;

exists (1:X0=1 /\ 1:X4=0)
