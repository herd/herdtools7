(* diyone7 -metadata false -arch AArch64 PodWW Rfe DpDatadR Amo.StAdd Coe *)
AArch64 S+po+data-amo.stadd
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0          | P1            ;
 MOV W0,#2   | LDR W0,[X3]   ;
 STR W0,[X1] | MOV W2,#1     ;
 MOV W2,#1   | EOR W4,W0,W0  ;
 STR W2,[X3] | ADD W2,W2,W4  ;
             | STADD W2,[X1] ;

exists ([x]=2 /\ 1:X0=1)
