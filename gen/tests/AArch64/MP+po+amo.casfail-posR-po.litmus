(* diyone7 -arch AArch64 -metadata false -nooptcond PodWW Rfe Amo.CasFail PosWR PodRR Fre *)
AArch64 MP+po+amo.casfail-posR-po
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0          | P1              ;
 MOV W0,#1   | MOV W0,#2       ;
 STR W0,[X1] | CAS W0,WZR,[X3] ;
 MOV W2,#1   | LDR W2,[X3]     ;
 STR W2,[X3] | LDR W4,[X1]     ;

exists (1:X0=1 /\ 1:X2=1 /\ 1:X4=0)
