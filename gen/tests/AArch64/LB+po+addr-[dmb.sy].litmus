(* diyone7 -arch AArch64 -metadata false DpAddrdW DMB.SY Rfe PodRW Rfe *)
AArch64 LB+po+addr-[dmb.sy]
{
 0:X0=x; 0:X3=y;
 1:X0=x; 1:X3=y;
}
 P0          | P1                ;
 LDR W1,[X0] | LDR W1,[X3]       ;
 MOV W2,#1   | EOR W2,W1,W1      ;
 STR W2,[X3] | ADD X0,X0,W2,SXTW ;
             | DMB SY            ;
             | MOV W4,#1         ;
             | STR W4,[X0]       ;

exists (0:X1=1 /\ 1:X1=1)
