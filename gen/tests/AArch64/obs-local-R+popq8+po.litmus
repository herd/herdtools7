(* diyone7 -arch AArch64 -metadata false -type int64_t -obs local PodWW q8 Coe PodWR Fre *)
AArch64 R+popq8+po
{
 int64_t x=0;
 int64_t y[2]={0,0};
 0:X1=x; uint64_t 0:X2=0; 0:X3=y; int64_t 0:X4=0; int64_t 0:X5=0;
 1:X1=x; int64_t 1:X2=0; 1:X3=y;
}
 P0             | P1          ;
 MOV X0,#1      | MOV X0,#2   ;
 STR X0,[X1]    | STR X0,[X3] ;
 MOV X2,#1      | LDR X2,[X1] ;
 STR X2,[X3,#8] |             ;
 LDP X4,X5,[X3] |             ;

exists (0:X5=1 /\ 0:X4=2 /\ 1:X2=0)
