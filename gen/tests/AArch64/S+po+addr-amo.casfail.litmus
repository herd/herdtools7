(* diyone7 -metadata false -arch AArch64 PodWW Rfe DpAddrdR Amo.CasFail Coe *)
AArch64 S+po+addr-amo.casfail
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0          | P1                ;
 MOV W0,#2   | LDR W0,[X3]       ;
 STR W0,[X1] | EOR W2,W0,W0      ;
 MOV W2,#1   | ADD X4,X1,W2,SXTW ;
 STR W2,[X3] | MOV W5,#1         ;
             | CAS W5,WZR,[X4]   ;

exists (1:X0=1 /\ 1:X5=0)
