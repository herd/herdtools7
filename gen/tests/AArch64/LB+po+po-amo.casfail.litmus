(* diyone7 -arch AArch64 -metadata false PodRR Amo.CasFail Rfe PodRW Rfe *)
AArch64 LB+po+po-amo.casfail
{
 0:X0=x; 0:X3=y;
 1:X0=x; 1:X3=y;
}
 P0          | P1              ;
 LDR W1,[X0] | LDR W1,[X3]     ;
 MOV W2,#1   | MOV W2,#1       ;
 STR W2,[X3] | CAS W2,WZR,[X0] ;

exists (1:X1=1 /\ 1:X2=0)
