(* diyone7 -arch AArch64 -metadata false -oneloc DpCtrlsW XAL Rfi *)
AArch64 CoRW1+ctrlspxal-rfixalp
{
 0:X0=x;
}
 P0               ;
 LDR W1,[X0]      ;
 CBNZ W1,LC00     ;
 LC00:            ;
 MOV W2,#1        ;
 Loop01:          ;
 LDAXR W3,[X0]    ;
 STLXR W4,W2,[X0] ;
 CBNZ W4,Loop01   ;

exists ([x]=1 /\ 0:X1=1 /\ 0:X3=0)
