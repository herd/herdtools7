(* diyone7 -metadata false -arch AArch64 PodWW Rfe DpCtrldR Amo.CasFail Coe *)
AArch64 S+po+ctrl-amo.casfail
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0          | P1              ;
 MOV W0,#2   | LDR W0,[X3]     ;
 STR W0,[X1] | CBNZ W0,LC00    ;
 MOV W2,#1   | LC00:           ;
 STR W2,[X3] | MOV W2,#1       ;
             | CAS W2,WZR,[X1] ;

exists (1:X0=1 /\ 1:X2=0)
