(* diyone7 -arch AArch64 -metadata false PodWW Rfe PodRR DSB.ST Fre *)
AArch64 MP+po+po-[dsb.st]
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0          | P1          ;
 MOV W0,#1   | LDR W0,[X3] ;
 STR W0,[X1] | DSB ST      ;
 MOV W2,#1   | LDR W2,[X1] ;
 STR W2,[X3] |             ;

exists (1:X0=1 /\ 1:X2=0)
