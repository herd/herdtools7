(* diyone7 -arch AArch64 -metadata false PodWW Rfe DpAddrCseldR Fre *)
AArch64 MP+po+addrcsel
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0          | P1                  ;
 MOV W0,#1   | LDR W0,[X3]         ;
 STR W0,[X1] | CMP W0,W0           ;
 MOV W2,#1   | CSEL W2,WZR,WZR,EQ  ;
 STR W2,[X3] | LDR W4,[X1,W2,SXTW] ;

exists (1:X0=1 /\ 1:X4=0)
