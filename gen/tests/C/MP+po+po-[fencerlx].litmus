(* diyone7 -arch C -metadata false PodWW Rfe PodRR FenceRlx Fre *)
(*
Warning: optimised conditions are not supported by C arch
*)
C MP+po+po-[fencerlx]

{}

P0 (volatile int* y,volatile int* x) {
  *x = 1;
  *y = 1;
}

P1 (volatile int* y,volatile int* x) {
  int r0 = *y;
  int r1 = *x;
}

exists (1:r0=1 /\ 1:r1=0)
