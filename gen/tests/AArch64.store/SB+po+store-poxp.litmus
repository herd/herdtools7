(* diyone7 -arch AArch64 -metadata false X Store PodWR Fre PodWR Fre *)
AArch64 SB+po+store-poxp
{
 0:X1=x; 0:X2=y;
 1:X1=x; 1:X2=y;
}
 P0          | P1              ;
 MOV W0,#1   | MOV W6,#1       ;
 STR W0,[X1] | STR W6,[X2]     ;
 LDR W3,[X2] | MOV W0,#2       ;
             | Loop00:         ;
             | LDXR W3,[X2]    ;
             | STXR W4,W0,[X2] ;
             | CBNZ W4,Loop00  ;
             | LDR W5,[X1]     ;

exists (0:X3=0 /\ 1:X3=1 /\ 1:X5=0)
