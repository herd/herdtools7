(* diyone7 -arch AArch64 -metadata false X Store PodWR Fre PodWR Fre *)
AArch64 SB+po+store-poxp
{
 0:X0=x; 0:X4=y;
 1:X0=x; 1:X4=y;
}
 P0              | P1          ;
 MOV W6,#1       | MOV W1,#1   ;
 STR W6,[X0]     | STR W1,[X4] ;
 MOV W1,#2       | LDR W2,[X0] ;
 Loop00:         |             ;
 LDXR W2,[X0]    |             ;
 STXR W3,W1,[X0] |             ;
 CBNZ W3,Loop00  |             ;
 LDR W5,[X4]     |             ;

exists ([x]=2 /\ 0:X2=1 /\ 0:X5=0 /\ 1:X2=0)
