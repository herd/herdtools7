(* diyone7 -arch AArch64 -metadata false Store PodWR Fre PodWR Fre *)
AArch64 SB+po+store-po
{
 0:X1=x; 0:X2=y;
 1:X1=x; 1:X2=y;
}
 P0          | P1          ;
 MOV W4,#1   | MOV W0,#1   ;
 STR W4,[X1] | STR W0,[X2] ;
 MOV W0,#2   | LDR W3,[X1] ;
 STR W0,[X1] |             ;
 LDR W3,[X2] |             ;

exists ([x]=2 /\ 0:X3=0 /\ 1:X3=0)
