(* diyone7 -arch AArch64 -variant memtag -metadata false -obs oo PodWW Rfe ExcEnter PosRR EretNext PodRR Fre *)
AArch64 MP+po+excenter-pos-eretnext-po
Variant=memtag
{
 0:X1=x:green; 0:X3=y:green;
 1:X1=x:green; 1:X3=y:green; uint64_t 1:X5=0;
}
 P0          | P1               | P1.F           ;
 MOV W0,#1   | L00: LDR W0,[X3] | ADD W2,W2,#1   ;
 STR W0,[X1] | LDR W6,[X1]      | LDR W4,[X3]    ;
 MOV W2,#1   |                  | MRS X5,ELR_EL1 ;
 STR W2,[X3] |                  | ADD X5,X5,#4   ;
             |                  | MSR ELR_EL1,X5 ;
             |                  | ERET           ;

exists (1:X2=1 /\ 1:X6=0)
