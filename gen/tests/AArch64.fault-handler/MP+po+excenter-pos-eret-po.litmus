(* diyone7 -arch AArch64 -variant memtag -metadata false PodWW Rfe ExcEnter PosRR Eret PodRR Fre *)
AArch64 MP+po+excenter-pos-eret-po
Variant=memtag
{
 0:X1=x:green; 0:X3=y:green;
 1:X1=x:green; 1:X3=y:green;
}
 P0          | P1               | P1.F         ;
 MOV W0,#1   | L00: LDR W0,[X3] | ADD W2,W2,#1 ;
 STR W0,[X1] | LDR W5,[X1]      | LDR W4,[X3]  ;
 MOV W2,#1   |                  | ERET         ;
 STR W2,[X3] |                  |              ;

exists (1:X2=1 /\ 1:X5=0)
