(* diyone7 -arch AArch64 -variant memtag -metadata false PodWW RevT Rfe PodRR Fre *)
AArch64 MP+poprevt+po
Variant=memtag
{
 0:X1=x:green; 0:X2=y:red; 0:X3=y:green;
 1:X1=x:green; 1:X3=y:green;
}
 P0          | P1               ;
 MOV W0,#1   | L00: LDR W0,[X3] ;
 STR W0,[X1] | LDR W4,[X1]      ;
 STG X2,[X3] |                  ;

exists (1:X4=0 /\ fault(P1:L00,y))
