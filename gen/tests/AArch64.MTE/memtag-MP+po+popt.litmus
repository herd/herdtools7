(* diyone7 -arch AArch64 -variant memtag -metadata false PodWW Rfe PodRR T Fre *)
AArch64 MP+po+popt
Variant=memtag
{
 0:X1=x:green; 0:X3=y:green;
 1:X1=x:green; 1:X3=y:green;
}
 P0          | P1          ;
 MOV W0,#1   | LDR W0,[X3] ;
 STR W0,[X1] | MOV X2,X1   ;
 MOV W2,#1   | LDG X2,[X1] ;
 STR W2,[X3] |             ;

exists (1:X0=1 /\ 1:X2=x:green)
