(* diyone7 -arch AArch64 -variant memtag -metadata false PodWW Rfe T PodRR T Fre *)
AArch64 MP+po+pott
Variant=memtag
{
 0:X1=x:green; 0:X3=y:green;
 1:X1=x:green; 1:X3=y:green;
}
 P0          | P1          ;
 MOV W0,#1   | MOV X0,X3   ;
 STR W0,[X1] | LDG X0,[X3] ;
 MOV W2,#1   | MOV X2,X1   ;
 STR W2,[X3] | LDG X2,[X1] ;

exists (1:X0=y:green /\ 1:X2=x:green)
