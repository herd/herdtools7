(* diyone7 -arch AArch64 -variant memtag -metadata false -oneloc RevT Rfe LxSx Coe *)
AArch64 CoRW2+rmw+RevT
Variant=memtag
{
 0:X0=x:green;
 1:X0=x:green; 1:X1=x:red;
}
 P0                   | P1          ;
 MOV W2,#1            | STG X1,[X0] ;
 Loop00:              |             ;
 L00: LDXR W1,[X0]    |             ;
 L01: STXR W3,W2,[X0] |             ;
 CBNZ W3,Loop00       |             ;

exists (fault(P0:L00,x) /\ fault(P0:L01,x))
