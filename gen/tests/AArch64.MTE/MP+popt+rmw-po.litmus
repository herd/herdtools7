(* diyone7 -arch AArch64 -metadata false -variant memtag PodWW T Rfe LxSx PodWR Fre *)
AArch64 MP+popt+rmw-po
Variant=memtag
{
 0:X1=x:green; 0:X2=y:red; 0:X3=y:green;
 1:X1=x:green; 1:X2=y:red;
}
 P0          | P1                   ;
 MOV W0,#1   | MOV W4,#1            ;
 STR W0,[X1] | Loop00:              ;
 STG X2,[X3] | L00: LDXR W0,[X2]    ;
             | L01: STXR W5,W4,[X2] ;
             | CBNZ W5,Loop00       ;
             | LDR W6,[X1]          ;

exists (1:X0=0 /\ 1:X6=0 /\ not (fault(P1:L00,y)) /\ not (fault(P1:L01,y)))
