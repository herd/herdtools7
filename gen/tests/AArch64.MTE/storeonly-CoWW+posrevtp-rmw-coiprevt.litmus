(* diyone7 -arch AArch64 -variant memtag,storeonly -metadata false -oneloc RevT PosWR LxSx Coi *)
AArch64 CoWW+posrevtp-rmw-coiprevt
Variant=memtag store-only
{
 0:X0=x:red; 0:X1=x:green;
}
 P0                   ;
 STG X0,[X1]          ;
 MOV W3,#1            ;
 Loop00:              ;
 LDXR W2,[X0]         ;
 L00: STXR W4,W3,[X0] ;
 CBNZ W4,Loop00       ;

exists (0:X2=0 /\ fault(P0:L00,x))
