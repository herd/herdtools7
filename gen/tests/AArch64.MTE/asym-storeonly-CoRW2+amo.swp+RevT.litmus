(* diyone7 -arch AArch64 -variant memtag,asym,storeonly -metadata false -oneloc RevT Rfi Amo.Swp Coi *)
AArch64 CoRW1+amo.swp-coiprevt-rfirevtp
Variant=asym memtag store-only
{
 0:X0=x:red; 0:X1=x:green;
}
 P0                  ;
 STG X0,[X1]         ;
 MOV W3,#1           ;
 L00: SWP W3,W2,[X1] ;

exists (fault(P0))
