(* diyone7 -arch AArch64 -variant memtag -metadata false RevT PodWW Rfe PodRR Fre *)
AArch64 MP+porevtp+po
Variant=memtag
{
 0:X0=x:red; 0:X1=x:green; 0:X3=y:green;
 1:X0=x:red; 1:X3=y:green;
}
 P0          | P1               ;
 STG X0,[X1] | LDR W2,[X3]      ;
 MOV W2,#1   | L00: LDR W4,[X0] ;
 STR W2,[X3] |                  ;

exists (1:X2=1 /\ fault(P1:L00,x))
