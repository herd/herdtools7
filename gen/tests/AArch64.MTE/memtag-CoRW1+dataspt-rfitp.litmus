(* diyone7 -arch AArch64 -variant memtag -metadata false -oneloc DpDatasW T Rfi *)
AArch64 CoRW1+dataspt-rfitp
Variant=memtag
{
 0:X0=x:red; 0:X4=x:green;
}
 P0                ;
 L00: LDR W1,[X0]  ;
 EOR W2,W1,W1      ;
 ADD X3,X0,W2,SXTW ;
 STG X3,[X4]       ;

exists (0:X1=0 /\ not (fault(P0:L00,x)))
