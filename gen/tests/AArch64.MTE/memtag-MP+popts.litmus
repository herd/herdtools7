(* diyone7 -arch AArch64 -variant memtag -metadata false PodWW T Rfe PodRR T Fre *)
AArch64 MP+popts
Variant=memtag
{
 0:X1=x:green; 0:X2=y:red; 0:X3=y:green;
 1:X1=x:green; 1:X2=y:red;
}
 P0          | P1               ;
 MOV W0,#1   | L00: LDR W0,[X2] ;
 STR W0,[X1] | MOV X4,X1        ;
 STG X2,[X3] | LDG X4,[X1]      ;

exists (1:X0=0 /\ 1:X4=x:green /\ not (fault(P1:L00,y)))
