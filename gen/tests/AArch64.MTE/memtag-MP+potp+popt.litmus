(* diyone7 -arch AArch64 -variant memtag -metadata false T PodWW Rfe PodRR T Fre *)
AArch64 MP+potp+popt
Variant=memtag
{
 0:X0=x:red; 0:X1=x:green; 0:X3=y:green;
 1:X1=x:green; 1:X3=y:green;
}
 P0          | P1          ;
 STG X0,[X1] | LDR W2,[X3] ;
 MOV W2,#1   | MOV X4,X1   ;
 STR W2,[X3] | LDG X4,[X1] ;

exists (1:X2=1 /\ 1:X4=x:green)
