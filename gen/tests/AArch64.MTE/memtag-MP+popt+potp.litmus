(* diyone7 -arch AArch64 -variant memtag -metadata false PodWW T Rfe T PodRR Fre *)
AArch64 MP+popt+potp
Variant=memtag
{
 0:X1=x:green; 0:X2=y:red; 0:X3=y:green;
 1:X1=x:green; 1:X2=y:red;
}
 P0          | P1          ;
 MOV W0,#1   | MOV X0,X2   ;
 STR W0,[X1] | LDG X0,[X2] ;
 STG X2,[X3] | LDR W4,[X1] ;

exists (1:X0=y:red /\ 1:X4=0)
