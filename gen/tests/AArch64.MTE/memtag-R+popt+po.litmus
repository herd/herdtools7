(* diyone7 -arch AArch64 -variant memtag -metadata false PodWW T Coe PodWR Fre *)
AArch64 R+popt+po
Variant=memtag
{
 0:X1=x:green; 0:X2=y:red; 0:X3=y:green;
 1:X1=x:green; 1:X2=y:red;
}
 P0          | P1               ;
 MOV W0,#1   | MOV W0,#1        ;
 STR W0,[X1] | L00: STR W0,[X2] ;
 STG X2,[X3] | LDR W4,[X1]      ;

exists ([y]=1 /\ 1:X4=0 /\ not (fault(P1:L00,y)))
