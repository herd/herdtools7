(* diyone7 -arch AArch64 -variant memtag,storeonly -metadata false -oneloc RevT Rfe LxSx Coe *)
AArch64 CoRW2+rmw+RevT
Variant=memtag store-only
{
 0:X0=x:green;
 1:X0=x:green; 1:X1=x:red;
}
 P0                   | P1          ;
 MOV W2,#1            | STG X1,[X0] ;
 Loop00:              |             ;
 LDXR W1,[X0]         |             ;
 L00: STXR W3,W2,[X0] |             ;
 CBNZ W3,Loop00       |             ;

exists (0:X1=1 /\ fault(P0:L00,x))
