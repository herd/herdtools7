(* diyone7 -arch AArch64 -variant memtag -metadata false -oneloc T PosWW RevT Rfe Fre *)
AArch64 WW+R+postrevt
Variant=memtag
{
 0:X0=x:blue; 0:X1=x:red; 0:X2=x:green;
 1:X2=x:green;
}
 P0          | P1               ;
 STG X0,[X1] | L00: LDR W3,[X2] ;
 STG X1,[X2] |                  ;

exists (fault(P1:L00,x))
