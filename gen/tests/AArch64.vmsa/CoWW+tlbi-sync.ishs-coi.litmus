(* diyone7 -arch AArch64 -variant vmsa -metadata false -oneloc TLBI-sync.ISHsWW Coi *)
AArch64 CoWW+tlbi-sync.ishs-coi
Variant=vmsa
{
 [x]=1;
 0:X1=x;
}
 P0              ;
 MOV W0,#3       ;
 STR W0,[X1]     ;
 DSB ISH         ;
 LSR X3,X1,#12   ;
 TLBI VAAE1IS,X3 ;
 DSB ISH         ;
 MOV W2,#2       ;
 STR W2,[X1]     ;

exists ([x]=3)
