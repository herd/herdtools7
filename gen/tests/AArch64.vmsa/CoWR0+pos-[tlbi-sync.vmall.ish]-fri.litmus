(* diyone7 -arch AArch64 -variant vmsa -metadata false -oneloc PosWR TLBI-sync.VMALL.ISH Fri *)
AArch64 CoWR0+pos-[tlbi-sync.vmall.ish]-fri
Variant=vmsa
{
 [x]=1;
 0:X1=x;
}
 P0             ;
 MOV W0,#2      ;
 STR W0,[X1]    ;
 DSB ISH        ;
 TLBI VMALLE1IS ;
 DSB ISH        ;
 LDR W2,[X1]    ;

exists (0:X2=1)
