(* diyone7 -arch AArch64 -variant vmsa -metadata false -oneloc PosWR TLBI-sync.ISH Fri *)
AArch64 CoWR0+pos-[tlbi-sync.ish]-fri
Variant=vmsa
{
 [x]=1;
 0:X1=x;
}
 P0              ;
 MOV W0,#2       ;
 STR W0,[X1]     ;
 DSB ISH         ;
 LSR X2,X1,#12   ;
 TLBI VAAE1IS,X2 ;
 DSB ISH         ;
 LDR W3,[X1]     ;

exists (0:X3=1)
