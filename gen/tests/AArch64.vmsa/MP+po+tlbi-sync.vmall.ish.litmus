(* diyone7 -arch AArch64 -variant vmsa -metadata false PodWW Rfe TLBI-sync.VMALL.ISHdRR Fre *)
AArch64 MP+po+tlbi-sync.vmall.ish
Variant=vmsa
{
 [x]=1;
 [y]=5;
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0          | P1             ;
 MOV W0,#2   | LDR W0,[X3]    ;
 STR W0,[X1] | DSB ISH        ;
 MOV W2,#6   | TLBI VMALLE1IS ;
 STR W2,[X3] | DSB ISH        ;
             | LDR W2,[X1]    ;

exists (1:X0=6 /\ 1:X2=1)
