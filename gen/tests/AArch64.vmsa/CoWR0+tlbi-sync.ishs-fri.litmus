(* diyone7 -arch AArch64 -variant vmsa -metadata false -oneloc TLBI-sync.ISHsWR Fri *)
AArch64 CoWR0+tlbi-sync.ishs-fri
Variant=vmsa
{
 [x]=1;
 0:X1=x;
}
 P0              ;
 MOV W0,#2       ;
 STR W0,[X1]     ;
 DSB ISH         ;
 LSR X3,X1,#12   ;
 TLBI VAAE1IS,X3 ;
 DSB ISH         ;
 LDR W2,[X1]     ;

exists (0:X2=1)
