Variant=vmsa
TTHM=P0:HD
{
 [x]=1;
 [PTE(x)]=(oa:PA(x), db:0, dbm:1);
 0:X0=PTE(x); 0:X1=(oa:PA(x), af:0, dbm:1); 0:X3=x;
}
