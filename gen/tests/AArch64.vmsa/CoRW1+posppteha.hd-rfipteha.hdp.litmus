(* diyone7 -arch AArch64 -variant vmsa -metadata false -oneloc PosRW PteHD PteHA Rfi *)
AArch64 CoRW1+posppteha.hd-rfipteha.hdp
Variant=vmsa
TTHM=P0:HA P0:HD
{
 [PTE(x)]=(oa:PA(x), af:0, db:0, dbm:1);
 0:X0=x;
}
 P0               ;
 L01: LDR W1,[X0] ;
 MOV W2,#1        ;
 L00: STR W2,[X0] ;

exists (0:X1=1 /\ fault(P0:L00,x) /\ not (fault(P0:L01,x)))
