(* diyone7 -arch AArch64 -variant vmsa -metadata false PodWW Rfe PodRR TLBI-sync.ISH Fre *)
AArch64 MP+po+po-[tlbi-sync.ish]
Variant=vmsa
{
 [x]=1;
 [y]=5;
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0          | P1              ;
 MOV W0,#2   | LDR W0,[X3]     ;
 STR W0,[X1] | DSB ISH         ;
 MOV W2,#6   | LSR X2,X1,#12   ;
 STR W2,[X3] | TLBI VAAE1IS,X2 ;
             | DSB ISH         ;
             | LDR W4,[X1]     ;

exists (1:X0=6 /\ 1:X4=1)
