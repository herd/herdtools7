(* diyone7 -hexa -arch AArch64 -variant fullmixed -metadata false -oneloc X h2 PosRW Rfi *)
AArch64 CoRW1+posx.h2w0-rfiw0x.h2
Variant=mixed
{
 0:X0=x; uint32_t 0:X1=0; uint32_t 0:X4=0x1010101;
}
