 Loop00:          ;
 LDXRH W1,[X2]    ;
 STXRH W3,W1,[X2] ;
 CBNZ W3,Loop00   ;
 STR W4,[X0]      ;

exists ([x]=0x1010101 /\ 0:X1=0x101)
