(* diyone7 -hexa -arch AArch64 -variant fullmixed -metadata false -oneloc PosRW X b1 Rfi *)
AArch64 CoRW1+posw0x.b1-rfix.b1w0
Variant=mixed
{
 uint32_t 0:X0=0; 0:X1=x;
}
 P0               ;
 LDR W0,[X1]      ;
 MOV W2,#1        ;
 ADD X4,X1,#1     ;
 Loop00:          ;
 LDXRB W3,[X4]    ;
 STXRB W5,W2,[X4] ;
 CBNZ W5,Loop00   ;

exists ([x]=0x100 /\ 0:X0=0x100 /\ 0:X3=0x0)
