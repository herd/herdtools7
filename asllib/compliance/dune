(executable
 (name gen)
 (modules gen))

(executable
 (name asltest)
 (modules asltest)
 (optional)
 (libraries yaml asllib))

(subdir
 run
 (dynamic_include ../generate/dune.inc))

(subdir
 generate
 (rule
  (deps
   (glob_files_rec ../%{env:ASL_TEST_DIR=tests}/*.asl)
   (glob_files_rec ../%{env:ASL_TEST_DIR=tests}/*.yaml))
  (action
   (with-stdout-to
    dune.inc
    (run ../gen.exe ../%{env:ASL_TEST_DIR=tests})))))
