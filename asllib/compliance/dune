(executable
 (name gen))

(executable
 (name asltest)
 (libraries yaml))

(subdir
 run
 (dynamic_include ../generate/dune.inc))

(subdir
 generate
 (rule
  (deps
   (glob_files_rec ../tests/*.asl)
   (glob_files_rec ../tests/*.yaml))
