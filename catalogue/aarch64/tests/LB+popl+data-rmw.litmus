AArch64 LB+popl+data-rmw
{
 0:X0=x; 0:X3=y;
 1:X0=x; 1:X3=y;
}
 P0           | P1              ;
 LDR W1,[X0]  | LDR W1,[X3]     ;
 MOV W2,#1    | MOV W4,#1       ;
 STLR W2,[X3] | EOR W5,W1,W1    ;
              | ADD W4,W4,W5    ;
              | LDXR W2,[X0]    ;
              | STXR W6,W4,[X0] ;

exists (0:X1=1 /\ 1:X1=1)
