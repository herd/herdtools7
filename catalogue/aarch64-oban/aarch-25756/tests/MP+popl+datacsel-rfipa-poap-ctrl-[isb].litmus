AArch64 MP+popl+datacsel-rfipa-poap-ctrl-[isb]
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y; 1:X4=z; 1:X6=a;
}
 P0           | P1                 ;
 MOV W0,#1    | LDR W0,[X3]        ;
 STR W0,[X1]  | CMP W0,W0          ;
 MOV W2,#1    | CSEL W2,WZR,WZR,EQ ;
 STLR W2,[X3] | ADD W2,W2,#1       ;
              | STR W2,[X4]        ;
              | LDAR W5,[X4]       ;
              | LDR W7,[X6]        ;
              | CBNZ W7,LC00       ;
              | LC00:              ;
              | ISB                ;
              | LDR W8,[X1]        ;

exists (1:X0=1 /\ 1:X5=1 /\ 1:X8=0)
