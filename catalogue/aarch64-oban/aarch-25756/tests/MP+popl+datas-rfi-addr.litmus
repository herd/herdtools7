AArch64 MP+popl+datas-rfi-addr
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0           | P1                  ;
 MOV W0,#1    | LDR W0,[X3]         ;
 STR W0,[X1]  | EOR W2,W0,W0        ;
 MOV W2,#1    | ADD W2,W2,#2        ;
 STLR W2,[X3] | STR W2,[X3]         ;
              | LDR W4,[X3]         ;
              | EOR W5,W4,W4        ;
              | LDR W6,[X1,W5,SXTW] ;

exists (1:X4=1 /\ 1:X6=0)
