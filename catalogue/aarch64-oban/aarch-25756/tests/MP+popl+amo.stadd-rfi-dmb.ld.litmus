AArch64 MP+popl+amo.stadd-rfi-dmb.ld
{
 0:X1=x; 0:X3=y;
 1:X1=x; 1:X3=y;
}
 P0           | P1            ;
 MOV W0,#1    | MOV W0,#2     ;
 STR W0,[X1]  | STADD W0,[X3] ;
 MOV W2,#1    | LDR W2,[X3]   ;
 STLR W2,[X3] | DMB LD        ;
              | LDR W4,[X1]   ;

exists ([y]=3 /\ 1:X2=3 /\ 1:X4=0)
