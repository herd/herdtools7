C Lock-outside-across

{}

P0(int *x, int *y, spinlock_t *sp)
{
	int r1;

	WRITE_ONCE(*x, 1);
	spin_lock(sp);
	r1 = READ_ONCE(*y);
	spin_unlock(sp);
}

P1(int *x, int *y, spinlock_t *sp)
{
	int r1;

	spin_lock(sp);
	WRITE_ONCE(*y, 1);
	spin_unlock(sp);
	r1 = READ_ONCE(*x);
}

exists (0:r1=0 /\ 1:r1=0)
