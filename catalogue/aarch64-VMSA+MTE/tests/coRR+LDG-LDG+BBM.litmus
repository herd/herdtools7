AArch64 coRR+LDG-LDG+BBM
Variant=vmsa,handled,mte,sync
{
 PTE(x)=(attrs:(TaggedNormal));
 [tag(y)]=:red; [tag(x)]=:green;
 0:X1=x; 1:X1=x;
 1:X0=(valid:0); 1:X3=PTE(x);
 1:X4=(oa:PA(y),attrs:(TaggedNormal));
 0:X2=x; 0:X4=x;
}
 P0           | P1             ;
L0:           | STR X0,[X3]    ;
  LDG X2,[X1] | DSB ISH        ;
L1:           | LSR X9,X1,#12  ;
  LDG X4,[X1] | TLBI VAAE1IS,X9;
              | DSB ISH        ;
              | STR X4,[X3]    ;
exists(0:X2=x:red /\ 0:X4=x:green)
