AArch64 Stores+Faults
Variant=vmsa
{
0:X0=1;
[PTE(x)]=(valid:0);
0:X1=x;
1:X1=PTE(x);
1:X0=(oa:PA(x));
1:X2=(oa:PA(x),db:0);
}
  P0          |  P1         ;
L0:           | STR X0,[X1] ;
 STR W0,[X1]  | DSB SY      ;
 DSB SY       | STR X2,[X1] ;
 ADD W0,W0,#1 |             ;
 STR W0,[X1]  |             ;

forall
  ([x]=1 => ~fault(P0:L0))
/\
  ([x]=2 => ~fault(P0))