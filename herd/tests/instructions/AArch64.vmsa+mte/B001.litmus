AArch64 B001
Variant=vmsa,mte,sync

(* Pre-indexed STG writes back the virtual address of a      *)
(* tagged memory region, not the translated physical address *)

{
    int y[8]={1,2,3,4,5,6,7,8};
    [PTE(x)]=(oa:PA(y),attrs:(TaggedNormal));
    0:X0=x:green;
    0:X1=x:red;
}

P0                 ;
ADD X2,X0,#16      ;
STG X1,[X0,#16]!   ;

forall (0:X0=0:X2)
