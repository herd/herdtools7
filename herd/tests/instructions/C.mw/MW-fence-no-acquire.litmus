C MW-fence-no-acquire
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  *x = 1;
  atomic_store_explicit(y, 1, memory_order_release);
}

P1 (int* x, int* y) {
  atomic_store_add_explicit(y, 1, memory_order_relaxed);
  atomic_thread_fence(memory_order_acquire);
  int r0 = *x;
}

filter ([y]=2)
exists (1:r0=0)
