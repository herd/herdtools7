ASL AnyActiveElementSymbolic
(* A symbolic input must not split into one execution per active position. *)

{ 0:X1=2; 0:X2=256; }

func main() => integer
begin
  let inactive = read_register(1);
  let active = read_register(2);
  CheckProp(!AnyActiveElementPrimitive{64}(inactive, 16));
  CheckProp(AnyActiveElementPrimitive{64}(active, 64));
  CheckProp(AnyActiveElementPrimitive{256}(active :: Zeros{192}, 64));
  write_register(0, active);
  return 0;
end;

forall 0:X0=256
