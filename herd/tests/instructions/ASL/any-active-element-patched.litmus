ASL AnyActiveElementPatched
(* Exercise the patched shared helper, not just the primitive. *)
Variant=asl+aarch64

{ 0:X1=2; }

func main() => integer
begin
  let mask = read_register(1)[15:0];
  CheckProp(AnyActiveElement{16}(mask, 8));
  CheckProp(!AnyActiveElement{16}(mask, 16));
  write_register(0, read_register(1));
  return 0;
end;

forall 0:X0=2
