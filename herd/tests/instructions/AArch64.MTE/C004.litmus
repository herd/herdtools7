AArch64 C004
Variant=mixed,mte

(* Check post-indexing of STZG that the tag granules are zeroed *)

{
    int x[8]={1,2,3,4,5,6,7,8};

    tag(x)   =:red;
    tag(x+16)=:red;

    0:X0=x:green; 0:X1=x:yellow;
}
P0                ;
MOV W2,#42        ;

STZG X1,[X0], #16 ; (* Offset with post-index + write-back *)
STZG X1,[X1, #16] ;

forall (x={0,0,0,0,0,0,0,0} /\ ~fault(P0,x,TagCheck))
