AArch64 SVE-GATHER-LD1B-SP
Variant=memtag,sync,sve:128

(* Active SVE gather lanes check the tags of their effective addresses. *)
{
  uint8_t x[8]={1,2,3,4,5,6,7,8};
  [tag(x)]=:green;
  0:SP=x:red;
}
P0;
  MOV Z0.S,#4;
  PTRUE P0.D,VL1;
  LD1B {Z1.D},P0/Z,[SP,Z0.S,UXTW];
forall(fault(P0,x,TagCheck))
