AArch64 ldr-preidx-fault
Variant=memtag,sync,

(* A synchronous Tag Check fault occurs before architectural pre-index
 * writeback.  The handler copies the base register for observation. *)

{
  int32_t x[2]={1,2};
  [tag(x)]=:green;
  0:X1=x:red;
}

P0               ;
L0:              ;
 LDR W0,[X1,#4]! ;

forall(fault(P0:L0,x,TagCheck) /\ 0:X1=x:red)
