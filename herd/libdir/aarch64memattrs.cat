(*** Device Memory ***)

(* Device Memory Types *)
let TTDDevice-GRE = try PTEDevice-GRE with emptyset
let TTDDevice-nGRE = try PTEDevice-nGRE with emptyset
let TTDDevice-nGnRE = try PTEDevice-nGnRE with emptyset
let TTDDevice-nGnRnE = try PTEDevice-nGnRnE with emptyset
let TTDDevice = TTDDevice-GRE | TTDDevice-nGRE | TTDDevice-nGnRE | TTDDevice-nGnRnE

(* Device memory cannot have more than one Device subtypes *)
assert empty TTDDevice-GRE & TTDDevice-nGRE & TTDDevice-nGnRE & TTDDevice-nGnRnE as Conflicting-Device-types

(*** Normal Memory ***)

let TTDNSH = try PTENSH with emptyset
let TTDISH = try PTEISH with emptyset
let TTDOSH = try PTEOSH with emptyset
let Shareability = TTDNSH | TTDISH | TTDOSH

let TTDiWB = try PTEiWB with emptyset
let TTDiWT = try PTEiWT with emptyset
let TTDiNC = try PTEiNC with emptyset
let InnerCacheability = TTDiWB | TTDiWT | TTDiNC

let TTDoWB = try PTEoWB with emptyset
let TTDoWT = try PTEoWT with emptyset
let TTDoNC = try PTEoNC with emptyset
let OuterCacheability = TTDoWB | TTDoWT | TTDoNC

let TaggedNormal = try PTETaggedNormal with emptyset
let TTDNormal = try PTENormal with emptyset

(*** Common attributes ***)
let TTDXS = try PTEXS with emptyset

(*** Definition of a relation between TTDs with the Same Attributes ***)
let same-Device =
  TTDDevice-GRE * TTDDevice-GRE
  | TTDDevice-nGRE * TTDDevice-nGRE
  | TTDDevice-nGnRE * TTDDevice-nGnRE
  | TTDDevice-nGnRnE * TTDDevice-nGnRnE

let same-shareability =
  TTDNSH * TTDNSH
  | TTDISH * TTDISH
  | TTDOSH * TTDOSH

let same-inner-cacheability =
  TTDiWB * TTDiWB
  | TTDiWT * TTDiWT
  | TTDiNC * TTDiNC

let same-outer-cacheability =
  TTDoWB * TTDoWB
  | TTDoWT * TTDoWT
  | TTDoNC * TTDoNC

let same-xs =
  PTEXS * PTEXS
  | (TTD \ PTEXS) * (TTD \ PTEXS)

let same-Normal = (TTDNormal * TTDNormal) & same-shareability &
    same-inner-cacheability & same-outer-cacheability & same-xs

let TTD-same-attrs = same-Normal | same-Device
