(* Same General Purpose Register *)
let same-gpr = [Rreg|Wreg]; loc; [Rreg|Wreg]

(* Intrinsic Direct Data Dependency *)
let ii_direct_data = iico_data \ (iico_data; [M]; iico_data)

(* Translation-intrinsically-before *)
let tr-ib =
  [Imp & TTD & R]; ii_direct_data; [B]; iico_ctrl; [Exp & M | Imp & Tag & R | MMU & FAULT | TagCheck & FAULT]

(* Effect with valid PA *)
let E-valid-PA = M | DC.CVAU | IC

(* Same Location *)
let same-loc =
  [E-valid-PA & ~(Tag & M)]; loc; [E-valid-PA & ~(Tag & M)]
  | [Tag & M]; loc; [Tag & M]

let same-low-order-bits = [E-valid-PA]; same-low-order-bits; [E-valid-PA]

(* Same-cache-line relation *)
(* NOTE : currently assumes all locations are on different cache lines *)
(*        also extends to IC without a location specified              *)
let scl = loc
  | (M | DC.CVAU | IC) * (IC.IALLU | IC.IALLUIS)
  | (IC.IALLU | IC.IALLUIS) * (M | DC.CVAU | IC)
 
(* Define pairs of exclusives *)
let lxsx = [Exp & R & EX]; po \ (po; [Exp & M & EX]; po); [Exp & W & EX]

(* Atomic Pair *)
(* This includes:                                                *)
(* 1. The Explicit Memory Effects of atomic instructions.        *)
(* 2. The Implicit Memory Effects of a hardware update of a TTD. *)
let amo = [Exp & R & X]; same-instance & loc; [Exp & W & X]
    | [Imp & TTD & R]; iico_data & to_data_port & loc; [Imp & TTD & W]

let rmw = amo | lxsx
