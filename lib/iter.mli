(** Push-based iterators. *)

type 'a t = ('a -> unit) -> unit

val fold : ('acc -> 'a -> 'acc) -> 'acc -> 'a t -> 'acc
(** [fold f init iter] folds [f] over every element produced by [iter], in
    iteration order. *)
